---
// Placeholder language home. Real copy, routing redirects and layout arrive in
// Stories 1.3–1.5.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../content/schemas.ts';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const name = 'Jujun Setiawan';
---

<BaseLayout lang={lang} title={name}>
  <main>
    <h1>{name}</h1>
  </main>
</BaseLayout>
