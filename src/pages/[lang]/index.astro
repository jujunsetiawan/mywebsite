---
// Placeholder language home. Routing redirects and real content arrive in
// Stories 1.4–1.6; the film island in Epic 3.
import type { GetStaticPaths } from 'astro';
import StaticLayout from '../../layouts/StaticLayout.astro';
import { LOCALES, type Locale } from '../../content/schemas.ts';

export const getStaticPaths = (() =>
  LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const name = 'Jujun Setiawan';
---

<StaticLayout lang={lang} title={name}>
  <h1 class="t-title-serif">{name}</h1>
</StaticLayout>
