---
// Office-styled static page frame (Story 1.3): skip link → top letterbox bar →
// <main id="main"> on surface.panel → footer letterbox bar.
// Named slot: `lang-switch`. When `path` is given (a mirrored route, Story 1.4)
// the layout fills `lang-switch` itself with the ID/EN switch and BaseLayout
// emits canonical + hreflang alternates. The footer bar always holds the
// "Privasi"/"Privacy" link to `/<lang>/privasi/` (Story 1.7), marked
// `aria-current="page"` on the privacy page itself.
import '../styles/tokens.css';
import '../styles/type.css';
import '../styles/base.css';
import BaseLayout from './BaseLayout.astro';
import StaticChrome from '../components/StaticChrome.astro';
import LangSwitch from '../components/LangSwitch.astro';
import type { Locale } from '../content/schemas.ts';
import { loadSiteConfig } from '../../config/load.ts';
import { t } from '../i18n/copy.ts';
import { localePath, PRIVACY_PATH } from '../i18n/routes.ts';

interface Props {
  lang: Locale;
  title: string;
  /** `<meta name="description">` in the page language (Story 1.9). */
  description: string;
  /** Serialised Person JSON-LD; language homes only (Story 1.9). */
  jsonLd?: string;
  /** Language-less route path ('' for home, e.g. 'proyek/x/'); omit for unmirrored pages. */
  path?: string;
  /** `noindex` meta in every environment (unindexable pages such as the empty archive). */
  noindex?: boolean;
}

const { lang, title, description, jsonLd, path, noindex } = Astro.props;
const { features } = loadSiteConfig();
const skipToContent = await t('chrome.skip-to-content', lang);
const footerLabel = await t('chrome.footer-label', lang);
const privacyLabel = await t('chrome.privacy', lang);
const privacyHref = localePath(lang, PRIVACY_PATH);
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={jsonLd} path={path} noindex={noindex}>
  <a class="skip-link t-ui-caps" href="#main">{skipToContent}</a>
  <StaticChrome lang={lang} features={features}>
    {
      path !== undefined ? (
        <LangSwitch slot="lang-switch" lang={lang} path={path} />
      ) : (
        <slot name="lang-switch" slot="lang-switch" />
      )
    }
  </StaticChrome>
  <main id="main" class="panel t-body" tabindex="-1">
    <slot />
  </main>
  <footer class="bar bar--bottom t-ui-caps" aria-label={footerLabel}>
    <a class="chrome-link" href={privacyHref} aria-current={path === PRIVACY_PATH ? 'page' : undefined} data-chrome="privacy">{privacyLabel}</a>
  </footer>
</BaseLayout>
