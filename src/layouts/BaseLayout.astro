---
import type { Locale } from '../content/schemas.ts';
import { loadSiteConfig } from '../../config/load.ts';
import { beaconToken, isIndexable } from '../../config/site.schema.ts';
import { alternates, canonical } from '../i18n/routes.ts';

interface Props {
  lang: Locale;
  title: string;
  /**
   * Language-less route path of a mirrored page ('' for home). When given,
   * the head carries a self-canonical and id/en/x-default alternates, always
   * absolute on the production origin (also in preview/development builds).
   */
  path?: string | undefined;
  /** Force `noindex` in every environment (e.g. the empty-archive page, Story 1.6). */
  noindex?: boolean | undefined;
}

const { lang, title, path } = Astro.props;
const site = loadSiteConfig();
const noindex = Astro.props.noindex === true || !isIndexable(site);
const token = beaconToken(site);
const canonicalHref = path === undefined ? null : canonical(site.productionOrigin, lang, path);
const alternateLinks = path === undefined ? [] : alternates(site.productionOrigin, path);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {canonicalHref !== null && <link rel="canonical" href={canonicalHref} />}
    {alternateLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {
      token !== null && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
