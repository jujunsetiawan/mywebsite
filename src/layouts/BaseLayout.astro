---
import type { Locale } from '../content/schemas.ts';
import { loadSiteConfig } from '../../config/load.ts';
import { beaconToken, isIndexable } from '../../config/site.schema.ts';
import { alternates, canonical, otherLocale } from '../i18n/routes.ts';
import { t } from '../i18n/copy.ts';
import { OG_HEIGHT, OG_LOCALES, OG_WIDTH, ogImageUrl, siteImagePath } from '../og/paths.ts';

interface Props {
  lang: Locale;
  title: string;
  /** `<meta name="description">` in the page language (Story 1.9); must be non-empty. */
  description: string;
  /**
   * Serialised JSON-LD (see `serializeJsonLd`) emitted as one
   * `<script type="application/ld+json">` data block; language homes only (Story 1.9).
   */
  jsonLd?: string | undefined;
  /**
   * Language-less route path of a mirrored page ('' for home). When given,
   * the head carries a self-canonical and id/en/x-default alternates, always
   * absolute on the production origin (also in preview/development builds).
   */
  path?: string | undefined;
  /** Force `noindex` in every environment (e.g. the empty-archive page, Story 1.6). */
  noindex?: boolean | undefined;
  /**
   * dist-relative Open Graph image (Story 1.10), e.g. `projectImagePath(lang, slug)`;
   * defaults to the site image of the page language.
   */
  ogImage?: string | undefined;
}

const { lang, title, description, jsonLd, path } = Astro.props;
if (typeof description !== 'string' || description.trim() === '') {
  throw new Error(`BaseLayout: empty meta description for "${title}" (${lang})`);
}
const site = loadSiteConfig();
const noindex = Astro.props.noindex === true || !isIndexable(site);
const token = beaconToken(site);
const canonicalHref = path === undefined ? null : canonical(site.productionOrigin, lang, path);
const alternateLinks = path === undefined ? [] : alternates(site.productionOrigin, path);
// Open Graph / Twitter (Story 1.10): absolute on the production origin in every env;
// pages without `path` (not-found pages) use their language home as og:url.
const ogUrl = canonicalHref ?? canonical(site.productionOrigin, lang, '');
const ogImage = ogImageUrl(site.productionOrigin, Astro.props.ogImage ?? siteImagePath(lang));
const siteName = await t('page.home.title', lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalHref !== null && <link rel="canonical" href={canonicalHref} />}
    {alternateLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALES[otherLocale(lang)]} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* A non-executed data block: CSP `script-src` does not apply to it. */}
    {jsonLd !== undefined && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {
      token !== null && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
