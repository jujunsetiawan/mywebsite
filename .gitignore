# Rendered media never enters version control.
pipeline/out/
pipeline/**/*.png
pipeline/**/*.jpg
pipeline/**/*.jpeg
pipeline/**/*.exr
pipeline/**/*.hdr
pipeline/**/*.gif
pipeline/**/*.webm
pipeline/**/*.tif
pipeline/**/*.tiff
pipeline/**/*.avif
pipeline/**/*.webp
pipeline/**/*.mp4
pipeline/**/*.mov
pipeline/**/*.mkv
pipeline/**/*.bin

# Spike (throwaway Node packages)
spike/node_modules/
spike/**/node_modules/
spike/**/out/
spike/player/public/media/
spike/player/dist/

# Blender backups
*.blend1
*.blend2

# Python
__pycache__/
*.pyc
